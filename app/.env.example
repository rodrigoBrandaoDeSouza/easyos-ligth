# Copie para .env e preencha.

# Supabase (Project Settings > API). Use a chave "anon"/"publishable" — NUNCA a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publica

# RevenueCat (Project settings > API keys > chaves PÚBLICAS de cada app)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx

# Links exigidos pela Apple/Google na tela de assinatura
EXPO_PUBLIC_URL_TERMOS=https://seusite.com.br/termos
EXPO_PUBLIC_URL_PRIVACIDADE=https://seusite.com.br/privacidade
