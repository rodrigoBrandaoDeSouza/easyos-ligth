{
  "expo": {
    "name": "EasyOS Light",
    "slug": "easyos-light",
    "scheme": "easyoslight",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.com.easyoslight.app",
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.easyoslight.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b48970e1-63bf-458e-8588-ae45f88ec92e"
      }
    },
    "owner": "rodrigobrandao"
  }
}
